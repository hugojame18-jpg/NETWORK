// CC Submit — Affiliate Network Platform
// Prisma schema: single source of truth for the relational data model.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  PUBLISHER
  ADVERTISER
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum OfferStatus {
  DRAFT
  PENDING
  ACTIVE
  PAUSED
  ARCHIVED
}

// Lifecycle of an affiliate link. The publisher REQUESTS a link for an offer;
// the admin then DELIVERs it by pasting the real (e.g. casino) tracking URL,
// which surfaces on the publisher's dashboard.
enum LinkStatus {
  REQUESTED
  DELIVERED
}

// Lifecycle of a publisher's request to promote one of the network's sites.
enum SiteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayoutType {
  CPA
  CPL
  CPS
  REVSHARE
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  ALL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

enum ConversionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PaymentStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum PaymentMethod {
  PAYPAL
  BANK_WIRE
  CRYPTO
  PAYONEER
  // An admin recording a payout they already sent needs to be able to name the
  // real channel (Revolut, Wise, cash in hand) rather than file it under the
  // nearest wrong label. Publishers still pick from the four above.
  OTHER
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  PAYMENT
  CONVERSION
  OFFER
}

enum PublisherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------------------------------------------------------------------------
// Identity, auth & RBAC
// ---------------------------------------------------------------------------

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  name            String
  image           String?
  role            UserRole
  status          UserStatus @default(PENDING)
  emailVerified   DateTime?
  twoFactorSecret String?

  publisher  Publisher?
  advertiser Advertiser?

  permissions         UserPermission[]
  notifications       Notification[]
  auditLogs           AuditLog[]           @relation("AuditActor")
  verificationTokens  VerificationToken[]
  passwordResetTokens PasswordResetToken[]
  sessions            Session[]
  enteredDailyStats   PublisherDailyStat[]
  announcements       Announcement[]
  trainingVideos      TrainingVideo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([status])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique // e.g. "offers.approve", "payments.review"
  description String

  users UserPermission[]

  createdAt DateTime @default(now())
}

model UserPermission {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, permissionId])
}

// ---------------------------------------------------------------------------
// Publisher / Advertiser profiles
// ---------------------------------------------------------------------------

model Publisher {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Short, human-readable sequential affiliate number (e.g. #1000) for easy
  // identification in the admin. Auto-assigned by the DB on creation.
  memberId Int @unique @default(autoincrement())

  companyName       String?
  website           String?
  trafficSources    String[]
  applicationStatus PublisherApplicationStatus @default(APPROVED)

  // Share of the gross revenue this affiliate keeps. PublisherDailyStat.revenue
  // holds what the advertiser pays the network; the affiliate earns that times
  // this rate. Defaults to the network's standard 50/50, and is per-affiliate
  // so a top performer can be moved to better terms without touching the rest.
  commissionRate Decimal @default(0.5) @db.Decimal(5, 4)

  // Application answers collected at sign-up and reviewed by an admin before
  // the publisher dashboard unlocks. Nullable so accounts created before the
  // questionnaire existed stay valid.
  // Set the first time the publisher finishes (or skips) the guided tour, so
  // it shows once per account rather than once per browser.
  onboardingSeenAt DateTime?

  workedWithNetworks Boolean @default(false)
  previousNetworks   String? // which ones, when workedWithNetworks is true
  affiliateExperience String?
  tiktokLinks         String?

  // Loyalty / referral. `referralCode` is a short, human-shareable code (see
  // generateReferralCode). Nullable so this additive migration needs no upfront
  // backfill — it's lazily ensured the first time a publisher opens the rewards
  // page. `referredBy` is the affiliate who referred this one (self-relation);
  // SetNull on delete so removing a parent account doesn't cascade-delete its
  // referrals.
  referralCode String?     @unique
  referredById String?
  referredBy   Publisher?  @relation("PublisherReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    Publisher[] @relation("PublisherReferrals")

  // Value this affiliate's traffic carries as sub3. The upstream network
  // echoes it back on its postback, which is how an incoming conversion finds
  // the right account. Random rather than sequential, so nobody can claim
  // someone else's conversions by guessing a number. Nullable because it is
  // assigned lazily to accounts that existed before postbacks.
  postbackToken String? @unique

  // Every other sub3 this affiliate's traffic carries. One account, several
  // sites: each site was set up with its own sub3 long before the account
  // existed, and making the affiliate reconfigure them all is asking for the
  // traffic to be lost in the meantime.
  sub3Aliases PublisherSub3[]

  paymentMethod  PaymentMethod?
  paymentDetails Json?

  balance     Decimal @default(0) @db.Decimal(12, 2)
  totalEarned Decimal @default(0) @db.Decimal(12, 2)
  minPayout   Decimal @default(250) @db.Decimal(12, 2)

  affiliateLinks AffiliateLink[]
  clicks         Click[]
  leads          Lead[]
  conversions    Conversion[]
  commissions    Commission[]
  payments       Payment[]
  dailyStats     PublisherDailyStat[]
  siteRequests   SiteRequest[]
  sites          AffiliateSite[]
  postbackHits   PostbackHit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([applicationStatus])
  @@index([referredById])
}

// A training video an admin publishes for publishers. Only the link is stored:
// the video itself lives wherever it was uploaded (YouTube, Loom…).
model TrainingVideo {
  id          String  @id @default(cuid())
  title       String
  description String?
  url         String
  active      Boolean @default(true)
  // Manual ordering, so lessons can be shown in teaching order rather than by
  // date. Ties fall back to creation order.
  position    Int     @default(0)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, position])
}

// A message written by an admin and shown on every publisher's dashboard.
// Kept separate from Notification: a notification is per-user and read once,
// an announcement is a single row that stays visible while `active`.
model Announcement {
  id     String  @id @default(cuid())
  title  String
  body   String
  active Boolean @default(true)

  // Kept if the admin account is later deleted, so the message doesn't vanish.
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
}

// A publisher asking to promote one of the network's ready-made sites. The
// site catalogue itself lives in code (src/lib/promo-sites.ts) — only the
// requests are persisted, keyed by the catalogue's stable slug.
model SiteRequest {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  siteSlug String
  status   SiteRequestStatus @default(PENDING)
  note     String?

  handledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([publisherId, siteSlug])
  @@index([status])
}

model Advertiser {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  website     String?

  totalSpent Decimal @default(0) @db.Decimal(12, 2)

  campaigns Campaign[]
  offers    Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Campaigns & Offers
// ---------------------------------------------------------------------------

model Campaign {
  id           String     @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      CampaignStatus @default(DRAFT)
  budget      Decimal?       @db.Decimal(12, 2)
  spent       Decimal        @default(0) @db.Decimal(12, 2)
  startDate   DateTime?
  endDate     DateTime?

  offers Offer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserId])
  @@index([status])
}

model Offer {
  id           String     @id @default(cuid())
  advertiserId String
  advertiser   Advertiser @relation(fields: [advertiserId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  name        String
  slug        String      @unique
  description String
  category    String
  status      OfferStatus @default(PENDING)

  payout     Decimal    @db.Decimal(12, 2)
  payoutType PayoutType @default(CPA)
  currency   String     @default("USD")

  countries    String[] // ISO country codes, empty = worldwide
  devices      DeviceType[]
  restrictions String?

  creativeUrl String?
  landingUrl  String
  previewUrl  String?
  cookieDays  Int     @default(30)
  dailyCap    Int?

  affiliateLinks AffiliateLink[]
  clicks         Click[]
  leads          Lead[]
  conversions    Conversion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([advertiserId])
  @@index([status])
  @@index([category])
}

// ---------------------------------------------------------------------------
// Tracking: links, clicks, leads, conversions, commissions
// ---------------------------------------------------------------------------

model AffiliateLink {
  id          String    @id @default(cuid())
  token       String    @unique // opaque tracking token used in the public URL
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  offerId     String
  offer       Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)

  label      String?
  subId      String?
  clickCount Int     @default(0)

  // Request/deliver flow: a link starts REQUESTED (publisher asked for it) and
  // becomes DELIVERED once the admin fills targetUrl with the real casino/brand
  // affiliate URL to show on the publisher's dashboard.
  status      LinkStatus @default(REQUESTED)
  targetUrl   String?
  deliveredAt DateTime?

  clicks Click[]
  leads  Lead[]

  createdAt DateTime @default(now())

  @@unique([publisherId, offerId, subId])
  @@index([publisherId])
  @@index([offerId])
}

model Click {
  id          String        @id @default(cuid())
  linkId      String
  link        AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  publisherId String
  publisher   Publisher     @relation(fields: [publisherId], references: [id], onDelete: Cascade)
  offerId     String
  offer       Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)

  cookieId  String     @unique
  ipHash    String
  userAgent String
  device    DeviceType @default(ALL)
  browser   String?
  os        String?
  country   String?
  referrer  String?
  subId     String?

  isFraud     Boolean @default(false)
  fraudReason String?

  leads Lead[]

  createdAt DateTime @default(now())

  @@index([publisherId, createdAt])
  @@index([offerId, createdAt])
  @@index([ipHash, createdAt])
  @@index([linkId])
}

model Lead {
  id          String        @id @default(cuid())
  clickId     String        @unique
  click       Click         @relation(fields: [clickId], references: [id], onDelete: Cascade)
  linkId      String
  link        AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  offerId     String
  offer       Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  publisherId String
  publisher   Publisher     @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  payload Json?
  status  ConversionStatus @default(PENDING)

  conversion Conversion?

  createdAt DateTime @default(now())

  @@index([publisherId, createdAt])
  @@index([offerId, createdAt])
}

model Conversion {
  id          String    @id @default(cuid())
  leadId      String    @unique
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  offerId     String
  offer       Offer     @relation(fields: [offerId], references: [id], onDelete: Cascade)
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  payout Decimal          @db.Decimal(12, 2)
  status ConversionStatus @default(PENDING)

  commission Commission?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisherId, createdAt])
  @@index([offerId, createdAt])
  @@index([status])
}

model Commission {
  id           String     @id @default(cuid())
  conversionId String     @unique
  conversion   Conversion @relation(fields: [conversionId], references: [id], onDelete: Cascade)
  publisherId  String
  publisher    Publisher  @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  amount Decimal          @db.Decimal(12, 2)
  status CommissionStatus @default(PENDING)

  paymentId String?
  payment   Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisherId, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Manually-entered daily statistics
//
// The automated tracking engine (Click/Lead/Conversion/Commission above)
// stays in place, but the numbers shown to publishers are NOT computed from
// it: the admin enters one row per publisher per day (clicks, hosts,
// conversions, revenue) and that row is the only source of truth the
// publisher dashboard reads from.
// ---------------------------------------------------------------------------

model PublisherDailyStat {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date // calendar day only — a plain DATE column sidesteps
  // the "timestamp without time zone" footgun where the DB session's
  // timezone silently shifts midnight by a few hours on write/read.
  clicks      Int      @default(0)
  hosts       Int      @default(0)
  conversions Int      @default(0)
  revenue     Decimal  @default(0) @db.Decimal(12, 2)

  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publisherId, date])
  @@index([publisherId, date])
  @@index([date])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod
  status PaymentStatus @default(PENDING)
  note   String?

  commissions Commission[]

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?
  paidAt      DateTime?

  @@index([publisherId, status])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Notifications, settings, audit
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType @default(INFO)
  title String
  body  String
  read  Boolean          @default(false)
  link  String?

  createdAt DateTime @default(now())

  @@index([userId, read])
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// A counter for the rate limiter, used when no Redis is configured. The
/// limiter used to depend on Redis alone and switched itself off without it,
/// which left sign-in open to unlimited guessing on any deployment that had
/// not set one up. The database is always there, so the limit always is too.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

model AuditLog {
  id      String  @id @default(cuid())
  actorId String?
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  action     String // e.g. "publisher.suspend", "offer.approve"
  targetType String // e.g. "User", "Offer", "Payment"
  targetId   String?
  metadata   Json?
  ipHash     String?

  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Global postback
// ---------------------------------------------------------------------------

enum PostbackStatus {
  ACCEPTED
  DUPLICATE
  UNKNOWN_TOKEN
  UNAUTHORIZED
  INVALID
  // The network took a conversion back (declined, charged back). Set on the
  // call that announced it and on the conversion it cancels.
  REVERSED
  // Understood and deliberately not counted: a pending conversion, or a
  // decline for something that was never counted in the first place.
  IGNORED
}

/// An additional sub3 attached to an affiliate, besides the primary one on
/// Publisher.postbackToken. Unique across the table, and checked in code
/// against the primary tokens too, so one sub3 can only ever mean one account.
/// Stored lower-cased and otherwise verbatim — a value with a stray backtick
/// typed into a site's config is still the value the network sends back.
model PublisherSub3 {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  token String @unique

  createdAt DateTime @default(now())

  @@index([publisherId])
}

/// Every call to the global postback endpoint, counted or not. These calls turn
/// directly into money owed, so there has to be a raw record of what arrived,
/// from where, and why it was or was not accepted — otherwise a network firing
/// a malformed postback is invisible until an affiliate complains.
///
/// Deliberately NOT unique on (publisherId, transactionId): a repeat delivery
/// has to be storable precisely so it can be seen, so duplicates are detected
/// in code against the accepted rows and then logged as DUPLICATE.
model PostbackHit {
  id String @id @default(cuid())

  publisherId String?
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)

  status        PostbackStatus
  sub3          String?
  amount        Decimal?       @db.Decimal(12, 2)
  transactionId String?
  offerName     String?

  /// The query string exactly as received, so a malformed call can be
  /// diagnosed without asking the network to fire another one.
  rawQuery String
  ip       String?
  message  String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([publisherId, createdAt])
  @@index([status, createdAt])
  @@index([publisherId, transactionId])
}

/// A page an affiliate generated from the network's template. Each one carries
/// its own sub3 (stored here and as a PublisherSub3, so the postback finds the
/// account) which is what lets the admin see which site a sale came from.
/// The page's text is rebuilt from this row and the offer settings every time
/// it is downloaded or deployed — nothing generated is stored.
model AffiliateSite {
  id          String    @id @default(cuid())
  publisherId String
  publisher   Publisher @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  name    String
  /// The sub3 this site's visitors carry.
  sub3    String @unique
  /// What the site's own heading says; the affiliate's, within limits.
  headline String
  /// The affiliate's own link for the button; the sub3 is always put on it.
  /// Empty: the offer's link from the admin settings.
  offerUrl String?

  netlifySiteId String?
  /// The address Netlify gave it (name.netlify.app), without the scheme.
  netlifyHost   String?
  /// A custom domain the affiliate attached, without the scheme.
  domain        String?
  deployedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publisherId])
}
